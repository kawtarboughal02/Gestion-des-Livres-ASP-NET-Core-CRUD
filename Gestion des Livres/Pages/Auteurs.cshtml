@page
@model AuteursModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Gestion des Livres</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
</head>
<body>
<div class="container-fluid nav-bar bg-transparent p-0">
        <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4" Style="margin-top:-50px;">
        <a href="/Index" class="navbar-brand d-flex align-items-center text-center">
            <h3 class="m-0 text-primary">Gestion des Livres</h3>
        </a>
        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto">
                <a href="/Index" class="nav-item nav-link active">Home</a>
                <a href="/Index" class="nav-item nav-link">About</a>
                <div class="nav-item dropdown">
                    <a href="/Auteurs" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Auteur</a>
                    <div class="dropdown-menu rounded-0 m-0">
                        <a href="/Auteurs" class="dropdown-item">Les Détails de L'Auteur</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <a href="/Categories" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Categorie</a>
                    <div class="dropdown-menu rounded-0 m-0">
                        <a href="/Categories" class="dropdown-item">Les Détails de Categorie</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <a href="/Editeurs" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Editeur</a>
                    <div class="dropdown-menu rounded-0 m-0">
                        <a href="/Editeurs" class="dropdown-item">Les Détails de L'Editeur</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <a href="/Livres" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Livre</a>
                    <div class="dropdown-menu rounded-0 m-0">
                        <a href="/Livres" class="dropdown-item">Les Détails de Livre</a>
                    </div>
                </div>
                <form class="d-flex">
                    <input class="form-control me-sm-1" type="search" placeholder="Rechercher" style="margin-left:50px;text-align:center;">
                    <button class="btn btn-secondary my-2 my-sm-0" type="submit">Rechercher</button>
                </form>
            </div>

        </div>
    </nav>
</div>
    <br>
    <h3 style="text-align:center;color:green;font-weight:bold"> Liste Des Auteurs </h3>
    <a class='btn btn-primary btn-sm' href='/Create'> Nouveau Auteur </a>
    <table class="table table-hover">
        <thead>
            <tr>
                <th style="text-align:center">ID</th>
                <th style="text-align:center">Nom</th>
                <th style="text-align:center">Email</th>
                <th style="text-align:center">Telephone</th>
                <th style="text-align:center">Adresse</th>
                <th style="text-align:center">Action</th>

            </tr>
        </thead>
        <tbody style="text-align:center">
            @foreach (var item in Model.listAuteurs)
            {
                <tr>
                    <td style="text-align:center">@item.IDAuteur</td>
                    <td style="text-align:center">@item.NomAuteur</td>
                    <td style="text-align:center">@item.EmailAuteur</td>
                    <td style="text-align:center">@item.telephoneAut</td>
                    <td style="text-align:center">@item.AdresseAut</td>
                    <td style="text-align:center">
                        <a class='btn btn-success btn-sm' href='/Edit?IDAuteur=@item.IDAuteur'> Modifier </a>
                        <a class='btn btn-danger btn-sm' href='/Delete?IDAuteur=@item.IDAuteur'> Supprimer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>