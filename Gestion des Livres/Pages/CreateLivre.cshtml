@page
@model Gestion_des_Livres.Pages.CreateLivreModel
@{
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Gestion des Livres</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="img/favicon.ico" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
</head>
<body>
    <div class="container-fluid nav-bar bg-transparent p-0">
        <nav class="navbar navbar-expand-lg bg-white navbar-light py-0 px-4">
            <a href="/Index" class="navbar-brand d-flex align-items-center text-center">
                <h3 class="m-0 text-primary">Gestion des Livres</h3>
            </a>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto">
                    <a href="/Index" class="nav-item nav-link">Home</a>
                    <a href="/Auteurs" class="nav-item nav-link">Auteurs</a>
                    <a href="/Categories" class="nav-item nav-link">Categories</a>
                    <a href="/Editeurs" class="nav-item nav-link">Editeurs</a>
                    <a href="/Livre/Livres" class="nav-item nav-link active">Livres</a>
                </div>
            </div>
        </nav>
    </div>
    <br />
    <h2 style="color:green">Nouveau Livre</h2>
    <br>
    @if (Model.errorMessage.Length > 0)
    {
        <div class='alert alert-warning alert-dismissible fade show' role='alert'>
            <strong>@Model.errorMessage</strong>
        </div>
    }
    <form method="post">
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Titre</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="Titre" value="@Model.livreInfo.Titre">
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">ISBN</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="ISBN" value="@Model.livreInfo.ISBN">
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Auteur</label>
            <div class="col-sm-6">
                <select class="form-control" name="IDAuteur">
                    <option value="">-- Choisir un auteur --</option>
                    @foreach (var a in Model.ListeAuteurs)
                    {
                        <option value="@a.Value">@a.Text</option>
                    }
                </select>
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Categorie</label>
            <div class="col-sm-6">
                <select class="form-control" name="IDCat">
                    <option value="">-- Choisir une categorie --</option>
                    @foreach (var c in Model.ListeCategories)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Editeur</label>
            <div class="col-sm-6">
                <select class="form-control" name="IDEditeur">
                    <option value="">-- Choisir un editeur --</option>
                    @foreach (var e in Model.ListeEditeurs)
                    {
                        <option value="@e.Value">@e.Text</option>
                    }
                </select>
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Annee d'edition</label>
            <div class="col-sm-6">
                <input type="number" class="form-control" name="AnneeEdition" value="@(Model.livreInfo.AnneeEdition == 0 ? "" : Model.livreInfo.AnneeEdition.ToString())">
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Description</label>
            <div class="col-sm-6">
                <textarea class="form-control" name="DescriptionLivre">@Model.livreInfo.DescriptionLivre</textarea>
            </div>
        </div>
        <div class="row mb-3">
            <div class="offset-sm3 col-sm-3 d-grid">
                <button type="submit" class="btn btn-primary"> Enregistrer </button>
            </div>
            <div class="col-sm-3 d-grid">
                <a class="btn btn-outline-success" href="/Livre/Livres" role="button">Annuler</a>
            </div>
        </div>
    </form>
</body>
</html>
